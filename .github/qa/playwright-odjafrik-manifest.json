{
  "version": 1,
  "runId": "odjafrik-playwright",
  "runNumber": 1,
  "project": {
    "name": "Odjafrik",
    "url": "https://odjafrik.com"
  },
  "cases": [
    {
      "code": "TC-ODJ-SEARCH",
      "title": "Rechercher un produit depuis l’accueil",
      "suite": "Odjafrik",
      "steps": [
        { "n": 1, "action": "Ouvrir https://odjafrik.com", "expected": "La page d’accueil s’affiche" },
        { "n": 2, "action": "Saisir « Agonlin » puis Entrée", "expected": "La recherche est lancée" },
        { "n": 3, "action": "Attendre la page de résultats", "expected": "L’URL contient search=Agonlin et des produits sont listés" }
      ]
    },
    {
      "code": "TC-ODJ-EMPTY-SEARCH",
      "title": "Recherche sans résultat : état vide",
      "suite": "Odjafrik",
      "steps": [
        { "n": 1, "action": "Ouvrir https://odjafrik.com", "expected": "La page d’accueil s’affiche" },
        { "n": 2, "action": "Saisir « zzzzznope » puis Entrée", "expected": "La recherche est lancée" },
        { "n": 3, "action": "Attendre l’état vide", "expected": "« Aucun produit trouvé » s’affiche sans erreur" }
      ]
    },
    {
      "code": "TC-ODJ-PRODUCT",
      "title": "Vérifier une fiche produit",
      "suite": "Odjafrik",
      "steps": [
        { "n": 1, "action": "Ouvrir la fiche du riz d’Agonlin", "expected": "La fiche produit s’affiche" },
        { "n": 2, "action": "Lire le prix et la disponibilité", "expected": "Le prix et « En stock » sont visibles" }
      ]
    },
    {
      "code": "TC-ODJ-CATALOG",
      "title": "Ouvrir le catalogue produits",
      "suite": "Odjafrik",
      "steps": [
        { "n": 1, "action": "Ouvrir https://odjafrik.com/products", "expected": "Le catalogue s’affiche" },
        { "n": 2, "action": "Vérifier les contrôles de liste", "expected": "Les filtres et le tri sont présents" }
      ]
    },
    {
      "code": "TC-ODJ-SELLERS",
      "title": "Ouvrir l’annuaire des vendeurs",
      "suite": "Odjafrik",
      "steps": [
        { "n": 1, "action": "Ouvrir https://odjafrik.com/sellers", "expected": "L’annuaire s’affiche" },
        { "n": 2, "action": "Vérifier le compteur et la recherche", "expected": "Le nombre de vendeurs et le champ de recherche sont visibles" }
      ]
    },
    {
      "code": "TC-ODJ-ARTISANS",
      "title": "Ouvrir l’annuaire des artisans",
      "suite": "Odjafrik",
      "steps": [
        { "n": 1, "action": "Ouvrir https://odjafrik.com/artisans", "expected": "L’annuaire s’affiche" },
        { "n": 2, "action": "Vérifier les fiches artisans", "expected": "Au moins un profil est proposé" }
      ]
    },
    {
      "code": "TC-ODJ-ANNONCES",
      "title": "Ouvrir les annonces des artisans",
      "suite": "Odjafrik",
      "steps": [
        { "n": 1, "action": "Ouvrir https://odjafrik.com/annonces", "expected": "La liste des annonces s’affiche" },
        { "n": 2, "action": "Vérifier une annonce et sa catégorie", "expected": "Une annonce de stylisme est visible" }
      ]
    }
  ]
}
