{
  "TC-ODJ-SEARCH": {
    "url": "https://odjafrik.com",
    "label": "la recherche « Agonlin »",
    "playwright": {
      "waitMs": 1500,
      "steps": [
        { "action": "goto", "url": "https://odjafrik.com" },
        { "action": "waitForText", "text": "Vendre sur Odjafrik", "timeoutMs": 20000 },
        { "action": "wait", "ms": 2500 },
        { "action": "fill", "placeholder": "Rechercher des produits, fournisseurs...", "value": "Agonlin" },
        { "action": "wait", "ms": 300 },
        { "action": "press", "placeholder": "Rechercher des produits, fournisseurs...", "key": "Enter" },
        { "action": "waitForUrl", "pattern": "search=Agonlin", "timeoutMs": 25000 },
        { "action": "waitForText", "text": "Agonlin", "timeoutMs": 25000 }
      ],
      "expect": {
        "url": "/products\\?search=Agonlin",
        "text": ["produits trouvés", "Agonlin", "FCFA"],
        "failIfText": ["Aucun produit"]
      }
    }
  },
  "TC-ODJ-EMPTY-SEARCH": {
    "url": "https://odjafrik.com",
    "label": "l’état vide d’une recherche sans résultat",
    "playwright": {
      "waitMs": 1500,
      "steps": [
        { "action": "goto", "url": "https://odjafrik.com" },
        { "action": "waitForText", "text": "Vendre sur Odjafrik", "timeoutMs": 20000 },
        { "action": "wait", "ms": 2500 },
        { "action": "fill", "placeholder": "Rechercher des produits, fournisseurs...", "value": "zzzzznope" },
        { "action": "wait", "ms": 300 },
        { "action": "press", "placeholder": "Rechercher des produits, fournisseurs...", "key": "Enter" },
        { "action": "waitForUrl", "pattern": "search=zzzzznope", "timeoutMs": 25000 },
        { "action": "waitForText", "text": "Aucun produit trouvé", "timeoutMs": 25000 }
      ],
      "expect": {
        "url": "/products\\?search=zzzzznope",
        "text": ["Aucun produit trouvé", "0 produits trouvés", "modifier vos filtres"],
        "failIfText": ["Impossible de charger"]
      }
    }
  },
  "TC-ODJ-PRODUCT": {
    "url": "https://odjafrik.com/product/35634176-4386-440f-9708-af9bfd1caac7",
    "label": "la fiche produit « Les merveilles d’Agonlin »",
    "playwright": {
      "waitMs": 1500,
      "steps": [
        { "action": "goto", "url": "https://odjafrik.com/product/35634176-4386-440f-9708-af9bfd1caac7" },
        { "action": "waitForText", "text": "En stock", "timeoutMs": 25000 },
        { "action": "waitForText", "text": "FCFA", "timeoutMs": 15000 }
      ],
      "expect": {
        "url": "/product/",
        "text": ["Agonlin", "15,000 FCFA", "En stock", "Ajouter"],
        "failIfText": ["Produit introuvable", "Impossible de charger le produit"]
      }
    }
  },
  "TC-ODJ-CATALOG": {
    "url": "https://odjafrik.com/products",
    "label": "le catalogue produits",
    "playwright": {
      "waitMs": 1500,
      "steps": [
        { "action": "goto", "url": "https://odjafrik.com/products" },
        { "action": "waitForText", "text": "Tous les produits", "timeoutMs": 25000 },
        { "action": "waitForText", "text": "Trier par", "timeoutMs": 15000 }
      ],
      "expect": {
        "url": "/products",
        "text": ["Tous les produits", "Trier par", "produits trouvés"],
        "failIfText": ["Une erreur est survenue"]
      }
    }
  },
  "TC-ODJ-SELLERS": {
    "url": "https://odjafrik.com/sellers",
    "label": "l’annuaire des vendeurs",
    "playwright": {
      "waitMs": 1200,
      "steps": [
        { "action": "goto", "url": "https://odjafrik.com/sellers" },
        { "action": "waitForText", "text": "Trouvez un vendeur", "timeoutMs": 25000 },
        { "action": "waitForText", "text": "Recherchez par nom d'entreprise", "timeoutMs": 15000 }
      ],
      "expect": {
        "url": "/sellers",
        "text": ["Trouvez un vendeur", "vendeur\\(s\\) trouvé", "Recherchez par nom d'entreprise"],
        "failIfText": ["Impossible de charger"]
      }
    }
  },
  "TC-ODJ-ARTISANS": {
    "url": "https://odjafrik.com/artisans",
    "label": "l’annuaire des artisans",
    "playwright": {
      "waitMs": 1200,
      "steps": [
        { "action": "goto", "url": "https://odjafrik.com/artisans" },
        { "action": "waitForText", "text": "Trouvez un artisan", "timeoutMs": 25000 },
        { "action": "waitForText", "text": "Voir le profil", "timeoutMs": 20000 }
      ],
      "expect": {
        "url": "/artisans",
        "text": ["Trouvez un artisan", "artisan\\(s\\) trouvé", "Voir le profil"],
        "failIfText": ["Impossible de charger"]
      }
    }
  },
  "TC-ODJ-ANNONCES": {
    "url": "https://odjafrik.com/annonces",
    "label": "les annonces des artisans",
    "playwright": {
      "waitMs": 1200,
      "steps": [
        { "action": "goto", "url": "https://odjafrik.com/annonces" },
        { "action": "waitForText", "text": "Annonces des artisans", "timeoutMs": 25000 },
        { "action": "waitForText", "text": "Stylisme et modélisme", "timeoutMs": 20000 }
      ],
      "expect": {
        "url": "/annonces",
        "text": ["Annonces des artisans", "annonce\\(s\\) trouvée", "Stylisme et modélisme"],
        "failIfText": ["Impossible de charger"]
      }
    }
  }
}
