{
  "version": 1,
  "runId": "demo-webmcp",
  "runNumber": 1,
  "project": {
    "name": "WebMCP demo",
    "url": "http://127.0.0.1:4173/webmcp-demo.html"
  },
  "cases": [
    {
      "code": "TC-WEBMCP-ECHO",
      "title": "Lire un outil WebMCP en lecture seule",
      "suite": "WebMCP",
      "steps": [
        { "n": 1, "action": "Ouvrir la page de démonstration", "expected": "Les outils WebMCP sont enregistrés" },
        { "n": 2, "action": "Exécuter demo_echo", "expected": "Le message est renvoyé" }
      ]
    },
    {
      "code": "TC-WEBMCP-ADD",
      "title": "Vérifier un calcul exposé par la page",
      "suite": "WebMCP",
      "steps": [
        { "n": 1, "action": "Ouvrir la page de démonstration", "expected": "Les outils WebMCP sont enregistrés" },
        { "n": 2, "action": "Exécuter demo_add(2, 3)", "expected": "La somme vaut 5" }
      ]
    },
    {
      "code": "TC-WEBMCP-CONFIRM",
      "title": "Confirmer une mutation",
      "suite": "WebMCP",
      "steps": [
        { "n": 1, "action": "Ouvrir la page de démonstration", "expected": "Les outils WebMCP sont enregistrés" },
        { "n": 2, "action": "Exécuter demo_set_status avec confirmation", "expected": "Le statut change et une confirmation est demandée" }
      ]
    },
    {
      "code": "TC-WEBMCP-REFUSE",
      "title": "Refuser une mutation sans confirmation",
      "suite": "WebMCP",
      "steps": [
        { "n": 1, "action": "Ouvrir la page de démonstration", "expected": "Les outils WebMCP sont enregistrés" },
        { "n": 2, "action": "Exécuter demo_set_status sans confirm", "expected": "La mutation est annulée" }
      ]
    }
  ]
}
