{
  "TC-WEBMCP-ECHO": {
    "url": "http://127.0.0.1:4173/webmcp-demo.html",
    "label": "le message renvoyé par demo_echo",
    "webmcp": {
      "tool": "demo_echo",
      "args": { "message": "bonjour-ci" },
      "expect": {
        "text": ["\"ok\":true", "bonjour-ci"]
      }
    }
  },
  "TC-WEBMCP-ADD": {
    "url": "http://127.0.0.1:4173/webmcp-demo.html",
    "label": "la somme calculée par demo_add",
    "webmcp": {
      "tool": "demo_add",
      "args": { "a": 2, "b": 3 },
      "expect": {
        "text": ["\"sum\":5"],
        "failIfText": ["\"sum\":6"]
      }
    }
  },
  "TC-WEBMCP-CONFIRM": {
    "url": "http://127.0.0.1:4173/webmcp-demo.html",
    "label": "le changement de statut confirmé",
    "webmcp": {
      "tool": "demo_set_status",
      "args": { "status": "actif" },
      "confirm": true,
      "expect": {
        "text": ["\"status\":\"actif\""],
        "dialog": true
      }
    }
  },
  "TC-WEBMCP-REFUSE": {
    "url": "http://127.0.0.1:4173/webmcp-demo.html",
    "label": "le refus de mutation sans confirmation",
    "webmcp": {
      "tool": "demo_set_status",
      "args": { "status": "inactif" },
      "expect": {
        "cancelled": true
      }
    }
  }
}
