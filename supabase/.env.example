# Copier vers supabase/.env.local (ignoré par git, chmod 600).
# Ne jamais committer ce fichier.

# Projet Supabase ciblé (Dashboard > Project Settings > General > Reference ID).
SUPABASE_PROJECT_REF=

# Jeton personnel Supabase (Dashboard > Account > Access Tokens).
SUPABASE_ACCESS_TOKEN=

# Mot de passe de la base (Dashboard > Project Settings > Database).
SUPABASE_DB_PASSWORD=

# GitHub App (voir la checklist).
# La clé téléchargée par GitHub est en PKCS#1. La convertir en PKCS#8 :
# openssl pkcs8 -topk8 -nocrypt -in github-app.pem -out github-app-pkcs8.pem
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/home/bill/.config/testdino/github-app.pem
GITHUB_REPO_FULL_NAME=owner/repo
GITHUB_INSTALLATION_ID=

# Modèle OpenCode par défaut : big-pickle, deepseek-v4.1-flash-free ou beam-free.
# Le workflow GitHub utilise un proxy local Gemini -> OpenAI.
# Les modèles gratuits utilisent le credential public `Bearer public` et
# l'identité du client OpenCode. La clé de service reste utile aux modèles
# payants et n'est jamais transmise à l'agent Antigravity.
ANTIGRAVITY_MODEL=big-pickle

# SMTP personnalisé Supabase Auth (Brevo, Resend, Postmark, Mailjet…).
# Nécessaire pour dépasser la limite de 2 emails/heure du fournisseur par défaut.
# Remplir puis lancer : node supabase/scripts/configure-smtp.mjs
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=BOG
EMAIL_RATE_LIMIT=30
